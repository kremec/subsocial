@@ -7,21 +8,35 @@
 export function Slider({
   value,
   onValueChange,
+  onSlidingComplete,
   min = 0,
   max = 1,
   step,
   disabled,
   testID,
   modifiers: extraModifiers,
+  minimumTrackTintColor,
 }: SliderProps) {
+  const lastValueRef = useRef(value);
   const modifiers: ModifierConfig[] = [];
