{
  "name": "subsocial",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start:staging": "APP_VARIANT=development expo start",
    "start:prod": "expo start",
    "run:staging:android": "APP_VARIANT=development expo run:android",
    "run:prod:android": "expo run:android",
    "run:staging:ios": "APP_VARIANT=development expo run:ios",
    "run:prod:ios": "expo run:ios",
    "eas:build:local": "eas build --platform android --profile preview --local",
    "eas:build:prod:preview:android": "APP_VARIANT=production eas build --platform android --profile preview",
    "eas:build": "eas build --platform android",
    "eas:submit": "eas submit --platform android",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsc --noEmit",
    "prepare": "git config --local include.path ../.githooks/.gitconfig"
  },
  "dependencies": {
    "@expo/ui": "~57.0.17",
    "@legendapp/list": "3.3.10",
    "@preeternal/react-native-cookie-manager": "^6.4.0",
    "@tabler/icons-react-native": "^3.44.0",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-image": "~57.0.4",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-quick-actions": "6.0.2",
    "expo-router": "~57.0.20",
    "expo-sharing": "~57.0.6",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-system-ui": "^57.0.2",
    "expo-updates": "~57.0.20",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.4.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-native-zoom-toolkit": "5.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "~6.0.3"
  },
  "patchedDependencies": {
    "expo-intent-launcher@57.0.1": "patches/expo-intent-launcher@57.0.1.patch",
    "expo-quick-actions@6.0.2": "patches/expo-quick-actions@6.0.2.patch"
